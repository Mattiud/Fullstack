# Copie este archivo como .env y complete los valores. Nunca suba .env al repositorio.

NODE_ENV=development
PORT=4000

# Cadena de conexión de MongoDB (local o MongoDB Atlas).
MONGODB_URI=mongodb://127.0.0.1:27017/sgp_psicopedagogia

# Secreto para firmar las sesiones: mínimo 32 caracteres aleatorios.
# Puede generarlo con: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=

# Origen exacto del frontend (obligatorio en producción).
CLIENT_ORIGIN=http://localhost:5173

# Número de proxies delante del servidor. En Render normalmente es 1.
# TRUST_PROXY=1

# Clave para cifrar los documentos adjuntos (AES-256-GCM): 64 caracteres hexadecimales.
# Genérela con: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Si se pierde o se cambia, los documentos ya guardados no podrán abrirse.
DOCUMENTOS_KEY=

# Tamaño máximo por documento, en MB (1 a 25). Por defecto 10.
# DOCUMENTOS_MAX_MB=10